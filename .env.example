# --- rmdig-portal environment variables ---
# Copy to .env.local for local dev. Do NOT commit real values.
# See CLAUDE_BOOTSTRAP.md §2 for context.

# Postgres (Neon). PostGIS extension required on the production branch.
DATABASE_URL=

# Auth.js v5. NEXTAUTH_URL is also the base of every emailed link; required
# when VERCEL_ENV=production (the server refuses to boot without it).
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (Apple Developer Console — Services ID + key + .p8 file).
# Apple does NOT support localhost or *.vercel.app callbacks; only testable on
# the verified custom domain (app.rmdig.ai). APPLE_PRIVATE_KEY is the contents
# of the .p8 file in PEM format with newlines as literal \n escapes (Option A
# from the Apple walkthrough), wrapped in double quotes.
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rmdig.ai

# Twilio Verify — org-creation phone OTP. Leave unset to disable phone
# verification (CI, local dev). Create a Verify service in the Twilio console
# (Verify → Services); the SID starts with VA.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Sentry (Next.js project). SENTRY_DSN is the server and edge DSN;
# NEXT_PUBLIC_SENTRY_DSN (the same value) turns on browser error reporting and
# is inlined into the client bundle at build. Environment and release come from
# Vercel's VERCEL_ENV / VERCEL_GIT_COMMIT_SHA. Cron monitors (lib/cron/jobs.ts)
# are created in Sentry on the first check-in.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: source-map upload. Set SENTRY_AUTH_TOKEN in CI/Vercel env,
# never in .env.local. SENTRY_ORG/PROJECT can also live in vercel.json.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel Blob (SAR proof-doc uploads in Phase 1)
# Vercel Blob store id. Set automatically on Vercel when a Blob store is
# connected to the project; uploads then use the function's OIDC identity.
BLOB_STORE_ID=
# Local-development fallback only (a store read-write token).
BLOB_READ_WRITE_TOKEN=

# AvServ S2S identity integration (direction B) — see
# rmdig-ai/docs/plans/05_portal_identity_integration.md.
# The portal links each user to a canonical AvServ account via server-to-server
# calls to /v1/internal/accounts, authenticated by a short-lived Ed25519 service
# JWT (kid svc-key-portal-1). Use mock://localhost for local dev until AvServ
# ships the endpoints; the mock path needs neither network nor a signing key.
AVSERV_BASE_URL=mock://localhost
# The Ed25519 private key that signs service JWTs, as ONE base64 line:
# `base64 -i key.pem | tr -d '\n'` of the PKCS#8 PEM (-----BEGIN PRIVATE KEY-----).
# No quotes. Vercel env only, never committed. AvServ holds the public half for
# the kid below. The production build fails unless the key loads and its public
# fingerprint equals AVSERV_SERVICE_JWT_KEY_SHA256 (runbook "AvServ service key").
AVSERV_SERVICE_JWT_SIGNING_KEY_B64=
# The key id the portal signs as; change it only to rotate (runbook).
AVSERV_SERVICE_JWT_KID=svc-key-portal-1
# SHA-256 of the DER public key, as AvServ reports it for that kid. Public.
AVSERV_SERVICE_JWT_KEY_SHA256=
# Optional second AvServ node (e.g. https://avserv-3.rmdig.ai). Agreement
# acceptances retry here with the same Idempotency-Key when AVSERV_BASE_URL is
# unreachable or answers 5xx/503. Unset = single node.
AVSERV_FAILOVER_BASE_URL=
# SAR intake: each AvServ node's HMAC secret for POST /api/sar/intake, packed
# "keyId:secret,keyId:secret" (e.g. sarintake-avserv-2-1:<64 hex>,...). Generate
# each with `openssl rand -hex 32`; the same secret goes in that node's .env as
# AVSERV_SAR_PORTAL_INTAKE_SECRET with AVSERV_SAR_PORTAL_INTAKE_KEY_ID. Never commit.
AVSERV_SAR_INTAKE_KEYS=

# Scheduled jobs (vercel.json crons): Vercel sends this as a Bearer token.
# Generate with `openssl rand -hex 32`. Unset: cron routes answer 503 and
# report it to Sentry.
CRON_SECRET=

# Surfaces built but waiting on AvServ endpoints that don't exist yet
# (lib/features.ts): 'on' | 'off', default 'off'. Off, their pages 404 and their
# server actions refuse. Turn one on only once AvServ ships its routes.
#   FEATURE_ADVERTISER_PORTAL: /advertiser/*, /advertiser-invite, admin ad approvals
#   FEATURE_RESTRICTION_REVIEW: /account/review, admin restriction reviews
FEATURE_ADVERTISER_PORTAL=off
FEATURE_RESTRICTION_REVIEW=off

# MFA enforcement: 'optional' | 'admin_only' | 'all'
# Default 'admin_only' (rmdig_admin/rmdig_reviewer must enroll; everyone else nagged).
# Flip to 'all' at public launch.
MFA_ENFORCEMENT=admin_only

# AES-256 key encrypting stored TOTP secrets at rest. Required once MFA is in
# use. Generate with: openssl rand -hex 32   (32 bytes = 64 hex chars)
# Set in Vercel env; never commit a real value. Rotating it invalidates every
# enrolled TOTP secret (users must re-enroll), so treat it as long-lived.
MFA_ENCRYPTION_KEY=

# Optional: surface a commit SHA in /healthz when running outside Vercel.
# Vercel sets VERCEL_GIT_COMMIT_SHA automatically in production.
GIT_COMMIT_SHA=

# Vercel sets VERCEL_ENV (production | preview | development). On "preview" the
# server refuses the production database and a non-mock AvServ, and email is
# logged instead of sent (runbook "Preview deployments").
# Preview only: comma-separated addresses that still get real email, for
# testing a template end to end. Empty = previews send nothing.
PREVIEW_EMAIL_RECIPIENTS=

# Map basemap (components/map/basemap.ts). MapTiler key (Flex plan), restricted to
# rmdig.ai and the preview domain in the MapTiler dashboard. Public by design.
# Unset: the free OpenStreetMap tiles (local dev).
NEXT_PUBLIC_MAPTILER_KEY=
