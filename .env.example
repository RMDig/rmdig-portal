# --- rmdig-portal environment variables ---
# Copy to .env.local for local dev. Do NOT commit real values.
# See CLAUDE_BOOTSTRAP.md §2 for context.

# Postgres (Neon). PostGIS extension required on the production branch.
DATABASE_URL=

# Auth.js v5
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (Apple Developer Console — Services ID + key + .p8 file).
# Apple does NOT support localhost or *.vercel.app callbacks; only testable on
# the verified custom domain (app.rmdig.ai). APPLE_PRIVATE_KEY is the contents
# of the .p8 file in PEM format with newlines as literal \n escapes (Option A
# from the Apple walkthrough), wrapped in double quotes.
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rmdig.ai

# Sentry (Next.js project)
SENTRY_DSN=
# Build-time only: source-map upload. Set SENTRY_AUTH_TOKEN in CI/Vercel env,
# never in .env.local. SENTRY_ORG/PROJECT can also live in vercel.json.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel Blob (SAR proof-doc uploads in Phase 1)
BLOB_READ_WRITE_TOKEN=

# AvServ S2S identity integration (direction B) — see
# rmdig-ai/docs/plans/05_portal_identity_integration.md.
# The portal links each user to a canonical AvServ account via server-to-server
# calls to /v1/internal/accounts, authenticated by a short-lived Ed25519 service
# JWT (kid svc-key-portal-1). Use mock://localhost for local dev until AvServ
# ships the endpoints; the mock path needs neither network nor a signing key.
AVSERV_BASE_URL=mock://localhost
# PKCS#8 PEM Ed25519 private key (the svc-key-portal-1 PRIVATE half). Mint with
# `avserv keygen --kid svc-key-portal-1` on the operator machine; publish only
# the PUBLIC half to AvServ's AVSERV_SERVICE_KEYS. Set this in Vercel env only —
# never commit a real value. Multiline PEM: wrap in double quotes with \n escapes.
AVSERV_SERVICE_JWT_SIGNING_KEY=

# Stripe Payment Link for the /contribute page (AvApp doc 35 §4.3, phase D1).
# Create it in the LLC's Stripe account (Payment Links → one-time, preset +
# custom amounts; NOT a subscription — recurring is deferred). Leave unset
# until the LLC Stripe + bank account exist: the page then shows "not open
# yet" instead of a button. Vercel env only; a change needs a redeploy.
CONTRIBUTE_PAYMENT_LINK_URL=

# MFA enforcement: 'optional' | 'admin_only' | 'all'
# Default 'admin_only' (rmdig_admin/rmdig_reviewer must enroll; everyone else nagged).
# Flip to 'all' at public launch.
MFA_ENFORCEMENT=admin_only

# AES-256 key encrypting stored TOTP secrets at rest. Required once MFA is in
# use. Generate with: openssl rand -hex 32   (32 bytes = 64 hex chars)
# Set in Vercel env; never commit a real value. Rotating it invalidates every
# enrolled TOTP secret (users must re-enroll), so treat it as long-lived.
MFA_ENCRYPTION_KEY=

# Optional: surface a commit SHA in /healthz when running outside Vercel.
# Vercel sets VERCEL_GIT_COMMIT_SHA automatically in production.
GIT_COMMIT_SHA=
